**/__pycache__/
*.pyc
**/.pytest_cache/
**/.ipynb_checkpoints/
.venv/
.env
build/
dist/
*.egg-info/
**/.DS_Store

# Keep the main walkthrough notebook visible in git even if broader
# notebook ignore rules are added later.
!notebooks/codebase_workflow_walkthrough.ipynb

# Files not intended for public visibility
archive/
sandbox/
viz/outputs/

# Keep only published notes from docs/notes.
docs/notes/*
!docs/notes/
!docs/notes/RESEARCH_LOG.md
!docs/notes/FINAL_REPRODUCIBILITY.md

# Local LaTeX toolchain (tectonic binary + pygmentize shim)
.tools/

# LaTeX build artifacts
Thesis/MSC_Thesis.zip
Thesis/MSC_Thesis/*.pdf
Thesis/MSC_Thesis/_minted-main/
Thesis/MSC_Thesis/*.aux
Thesis/MSC_Thesis/*.bbl
Thesis/MSC_Thesis/*.blg
Thesis/MSC_Thesis/*.log
Thesis/MSC_Thesis/*.out
Thesis/MSC_Thesis/*.toc
Thesis/MSC_Thesis/*.xdv
